{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node"
    ],
    "paths": {
      "@korus-dev/multi-agent-sdk": [
        "./src/index.ts"
      ],
      "@korus-dev/multi-agent-sdk/prompt": [
        "./src/prompt.ts"
      ],
      "@korus-dev/multi-agent-sdk/codex": [
        "./src/codex.ts"
      ],
      "@korus-dev/multi-agent-sdk/contracts": [
        "./src/contracts-entry.ts"
      ],
      "@korus-dev/multi-agent-sdk/claude": [
        "./src/claude.ts"
      ],
      "@korus-dev/multi-agent-sdk/cursor": [
        "./src/cursor.ts"
      ],
      "@korus-dev/multi-agent-sdk/antigravity": [
        "./src/antigravity.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
