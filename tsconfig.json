{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "paths": {
      "@korus-dev/multi-agent-sdk": [
        "./src/index.ts"
      ],
      "@korus-dev/multi-agent-sdk/prompt.js": [
        "./src/prompt.ts"
      ],
      "@korus-dev/multi-agent-sdk/native.js": [
        "./src/native.ts"
      ],
      "@korus-dev/multi-agent-sdk/codex.js": [
        "./src/providers/codex/index.ts"
      ],
      "@korus-dev/multi-agent-sdk/surface-bridge.js": [
        "./src/core/surface-bridge.ts"
      ],
      "@korus-dev/multi-agent-sdk/web.js": [
        "./src/web/index.ts"
      ],
      "@korus-dev/multi-agent-sdk/web/client.js": [
        "./src/web/client.ts"
      ],
      "@korus-dev/multi-agent-sdk/web/server.js": [
        "./src/web/server.ts"
      ],
      "@korus-dev/multi-agent-sdk/web/protocol.js": [
        "./src/web/protocol.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
