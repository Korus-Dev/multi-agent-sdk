{
  "version": "0.25.0",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "prompt.js",
    "prompt.d.ts",
    "surface-bridge.js",
    "surface-bridge.d.ts",
    "native.js",
    "native.d.ts",
    "codex.js",
    "codex.d.ts",
    "docs/**/*.md",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && node scripts/typecheck.mjs plain -p tsconfig.build.json",
    "typecheck": "node scripts/typecheck.mjs plain --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run typecheck:tests && npm run test:coverage && npm run build && npm run check:package && npm run build:docs",
    "check:package": "node scripts/check-package.mjs",
    "dev:docs": "vitepress dev docs --port 5175",
    "build:docs": "npm run typecheck:examples && vitepress build docs",
    "preview:docs": "vitepress preview docs --port 4175",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "typecheck:tests": "node scripts/typecheck.mjs plain -p tsconfig.tests.json --noEmit"
  },
  "name": "@korus-dev/multi-agent-sdk",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.8.0",
    "@korus-dev/codex-sdk": "0.167.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "image-size": "2.0.4",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Unified native coding-agent harness interface and adapters.",
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/yauzl": "2.10.3",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "6.0.3",
    "vite": "8.1.7",
    "vitepress": "1.6.4",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Korus-Dev/multi-agent-sdk.git"
  },
  "author": "Nicolas Bonamy",
  "homepage": "https://github.com/Korus-Dev/multi-agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/Korus-Dev/multi-agent-sdk/issues"
  },
  "keywords": [
    "agents",
    "codex",
    "claude",
    "cursor",
    "acp",
    "mcp",
    "typescript"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "overrides": {
    "vitepress": {
      "vite": "6.4.6"
    }
  }
}
