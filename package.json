{
  "name": "@korus-dev/multi-agent-sdk",
  "version": "0.27.0",
  "description": "Unified native coding-agent harness interface and adapters.",
  "license": "Apache-2.0",
  "author": "Nicolas Bonamy",
  "homepage": "https://korus-dev.github.io/multi-agent-sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Korus-Dev/multi-agent-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Korus-Dev/multi-agent-sdk/issues"
  },
  "keywords": [
    "agents",
    "codex",
    "claude",
    "cursor",
    "acp",
    "mcp",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./contracts": {
      "types": "./dist/contracts-entry.d.ts",
      "default": "./dist/contracts-entry.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./codex": {
      "types": "./dist/codex.d.ts",
      "default": "./dist/codex.js"
    },
    "./claude": {
      "types": "./dist/claude.d.ts",
      "default": "./dist/claude.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    },
    "./antigravity": {
      "types": "./dist/antigravity.d.ts",
      "default": "./dist/antigravity.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && node scripts/typecheck.mjs plain -p tsconfig.build.json",
    "typecheck": "node scripts/typecheck.mjs plain --noEmit",
    "typecheck:tests": "node scripts/typecheck.mjs plain -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "test:ai": "vitest --run --silent --reporter=./tests/reporter/silent.ts",
    "test:coverage": "vitest run --coverage",
    "check:package": "node scripts/check-package.mjs",
    "build:docs": "npm run typecheck:examples && vitepress build docs",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run typecheck:tests && npm run test:coverage && npm run build && npm run check:package && npm run build:docs",
    "dev:docs": "vitepress dev docs --port 5175",
    "preview:docs": "vitepress preview docs --port 4175",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.322",
    "@anthropic-ai/sdk": "1.8.0",
    "@korus-dev/codex-sdk": "0.167.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "image-size": "2.0.4",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "25.9.5",
    "@types/yauzl": "2.10.3",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "6.0.3",
    "vite": "8.1.7",
    "vitepress": "1.6.4",
    "vitest": "4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.6"
    }
  }
}
